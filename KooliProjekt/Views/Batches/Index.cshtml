@model KooliProjekt.Models.BatchesIndexModel

@{
    ViewData["Title"] = "Batches";
}

<h1>Batches</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add new</a>
</p>

<form method="get" class="form-inline" style="margin-bottom:20px">
        <div class="form-group" style="margin-right:10px">
            <label asp-for="Search.Keyword" class="control-label">Code or description</label>
            <input asp-for="Search.Keyword" class="form-control" placeholder="Code or description" />
        </div>
        <div class="form-group" style="margin-right:10px">
            <label asp-for="Search.BeerTypeId" class="control-label">Beer type</label>
            <select asp-for="Search.BeerTypeId" asp-items="ViewBag.BeerTypeId" class="form-control">
                <option value="">-- all --</option>
            </select>
        </div>
        <div class="form-group" style="margin-right:10px">
            <label asp-for="Search.DateFrom" class="control-label">Date from</label>
            <input asp-for="Search.DateFrom" type="date" class="form-control" />
        </div>
        <div class="form-group" style="margin-right:10px">
            <label asp-for="Search.DateTo" class="control-label">Date to</label>
            <input asp-for="Search.DateTo" type="date" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-default">Clear</a>
</form>

<table class="table table-striped">
    <thead>
        <tr>
                <th>Code</th>
                <th>Beer type</th>
                <th>Batch date</th>
                <th>Description</th>
                <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Data.Results)
        {
            <tr>
                    <td>@item.Code</td>
                    <td>@item.BeerType?.Name</td>
                    <td>@item.BatchDate.ToString("dd.MM.yyyy")</td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync<PagerViewComponent>(Model.Data))
