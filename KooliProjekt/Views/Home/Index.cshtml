@{
    ViewData["Title"] = "Home";
}

<h1>Pruulikoda</h1>
<p>Proovipruulide saamisloo jäädvustamine: õllesordid, proovipartiid, koostisosad, pruulimise logi, maitsmised ja fotod.</p>

@if (User.Identity?.IsAuthenticated == true)
{
    <ul class="list-unstyled">
        <li><a asp-controller="BeerTypes" asp-action="Index">Beer types</a></li>
        <li><a asp-controller="Batches" asp-action="Index">Batches</a></li>
        <li><a asp-controller="Ingredients" asp-action="Index">Ingredients</a></li>
        <li><a asp-controller="LogEntries" asp-action="Index">Brewing log</a></li>
        <li><a asp-controller="TastingEntries" asp-action="Index">Tasting log</a></li>
        <li><a asp-controller="BatchPhotos" asp-action="Index">Batch photos</a></li>
    </ul>
}
else
{
    <p>Süsteemi kasutamiseks <a asp-area="Identity" asp-page="/Account/Login">logi sisse</a>.</p>
}
