@model KooliProjekt.Data.Ingredient

@{
    ViewData["Title"] = "Delete ingredient";
}

<h1>Delete ingredient</h1>

<h3>Are you sure you want to delete this?</h3>
<hr />
<dl class="dl-horizontal">
        <dt>Batch</dt>
        <dd>@Model.Batch?.Code</dd>
        <dt>Name</dt>
        <dd>@Model.Name</dd>
        <dt>Unit</dt>
        <dd>@Model.Unit</dd>
        <dt>Unit price</dt>
        <dd>@Model.UnitPrice.ToString("0.00")</dd>
        <dt>Quantity</dt>
        <dd>@Model.Quantity.ToString("0.###")</dd>
        <dt>Total</dt>
        <dd>@Model.Total.ToString("0.00")</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <input type="submit" value="Delete" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-default">Back to list</a>
</form>
