@model PagedResult<KooliProjekt.Data.Ingredient>

@{
    ViewData["Title"] = "Ingredients";
}

<h1>Ingredients</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add new</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
                <th>Batch</th>
                <th>Name</th>
                <th>Unit</th>
                <th>Unit price</th>
                <th>Quantity</th>
                <th>Total</th>
                <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Results)
        {
            <tr>
                    <td>@item.Batch?.Code</td>
                    <td>@item.Name</td>
                    <td>@item.Unit</td>
                    <td>@item.UnitPrice.ToString("0.00")</td>
                    <td>@item.Quantity.ToString("0.###")</td>
                    <td>@item.Total.ToString("0.00")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
            </tr>
        }
    </tbody>
</table>

@(await Component.InvokeAsync<PagerViewComponent>(Model))
